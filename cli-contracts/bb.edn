{:min-bb-version "1.12.218"
 :paths ["src"]
 :tasks
 {test
  {:doc "Run the account-registration contracts against one target executable"
   :requires ([contract.runner :as runner])
   :task (apply runner/-main *command-line-args*)}

  verify-faulty
  {:doc "Verify that the approved faulty candidates are discriminated"
   :requires ([contract.verify-faulty :as verify])
   :task (apply verify/-main *command-line-args*)}}}
