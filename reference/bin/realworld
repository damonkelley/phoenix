#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PROJECT_CLASSPATH=$(cd "$PROJECT_DIR" && clojure -Spath)

exec java \
  -cp "$PROJECT_DIR/src:$PROJECT_DIR/resources:$PROJECT_CLASSPATH" \
  clojure.main -m realworld.adapter.cli.main "$@"
