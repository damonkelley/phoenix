#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
JAVA=$(mise which -C "$PROJECT_DIR" java)
PROJECT_CLASSPATH=$(mise exec -C "$PROJECT_DIR" -- clojure -Spath)

exec "$JAVA" \
  -cp "$PROJECT_DIR/src:$PROJECT_DIR/resources:$PROJECT_CLASSPATH" \
  clojure.main -m realworld.adapter.cli.main "$@"
